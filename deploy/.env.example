# Copy to deploy/.env (never commit the real file) and fill in.
SWARM_DOMAIN=swarm.example.com

# Model provider: Claude ...
ANTHROPIC_API_KEY=
# ... or any OpenAI-compatible provider (then also set SWARM_MODEL and SWARM_PRICE)
# SWARM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.river.ai/v1
# OPENAI_API_KEY=
# SWARM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# SWARM_PRICE=0.12,0.48,0.0024

# Free web search
TINYFISH_API_KEY=

# Server
SWARM_MAX_USD_PER_JOB=2
SWARM_DEFAULT_RPM=60
SWARM_JOB_TIMEOUT_S=1800
SWARM_RETENTION_DAYS=30
SWARM_ALLOW_MOCK=false
# Scrape /metrics with this token (or an admin key)
SWARM_METRICS_TOKEN=
# Optional single admin token; prefer `swarm keys create` per user
# SWARM_API_TOKEN=
